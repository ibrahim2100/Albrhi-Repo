<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>ar</string>
	<!-- Arabic alone, and that is measured rather than assumed. Declaring “ar, en” makes iOS
	     pick the phone's language, so an English phone laid the whole app out left-to-right —
	     title on the left, tabs reversed — while every string on it stayed Arabic. The screens
	     are written in one language, so they are laid out in that language's direction whatever
	     the phone is set to. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>تراخيص البرهي</string>
	<key>CFBundleExecutable</key>
	<string>AlbrhiLicences</string>
	<key>CFBundleIdentifier</key>
	<string>com.albrhi.licences</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AlbrhiLicences</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.4</string>
	<key>CFBundleVersion</key>
	<string>1.0.4</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>MinimumOSVersion</key>
	<string>15.0</string>
	<!-- An empty UILaunchStoryboardName is not “no launch screen”; it names a storyboard that
	     does not exist, and an app iOS cannot find a launch screen for is run letterboxed at the
	     old 4-inch size. An empty UILaunchScreen dict is the iOS 14+ way of saying “plain”. -->
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<!-- Face ID, and the reason said in the words the prompt shows. A licence server on a phone
	     is worth exactly one sentence of explanation to whoever is holding it. -->
	<key>NSFaceIDUsageDescription</key>
	<string>لفتح لوحة التراخيص</string>

	<!-- The background refresh that notices a new request while the app is closed.
	     Both keys are needed and the identifier must match SCINotify's exactly: an identifier the
	     plist does not list is refused at registration, and iOS refuses it by throwing at launch. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.albrhi.licences.refresh</string>
	</array>

	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>AppIcon60x60</string>
			</array>
			<key>UIPrerenderedIcon</key>
			<true/>
		</dict>
	</dict>
</dict>
</plist>
