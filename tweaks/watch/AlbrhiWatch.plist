<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <!-- Pairing is answered here. NanoRegistry's compatibility questions are asked
                 inside SpringBoard, which is also where the preference writes belong: the
                 process runs as mobile, and the pairing core refuses to write from anything
                 that is not. -->
            <string>com.apple.springboard</string>

            <!-- The Watch app. The update surface is here and nowhere else: `SUBManager` lives in
                 SoftwareUpdateBridge, which this process links, and `COSSoftwareUpdateController`
                 is what the app's own General.plist names as its Software Update page. Loading
                 into it also lets the probe report what those classes really look like, which is
                 the only way to read a class that lives in the shared cache. -->
            <string>com.apple.Bridge</string>
        </array>
    </dict>

    <!-- No SCIPanelGroup* keys, deliberately. They told Albrhi Panel to draw a row for this
         tweak and push to a page inside its bundle; Albrhi Watch ships its own Settings row and its
         own preference bundle now, so the panel has nothing to say about it. Albrhi is the
         social-app tweak; this is a separate one. -->
	<!-- And nothing at all in Albrhi's panel.

	     Without this the panel would still find this filter beside its dylib and draw a row
	     per process in it (“SpringBoard”, “Music”, “Spotify”), which is the exact mistake the
	     group keys above used to prevent, arriving from the other direction now that the page
	     has moved out of that bundle. Albrhi Watch has its own row in Settings; Albrhi is the
	     social-app tweak and has nothing to say about this one. -->
	<key>SCIPanelHidden</key>
	<true/>
</dict>
</plist>
