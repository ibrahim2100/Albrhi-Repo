<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <!-- Pairing is answered here. NanoRegistry's compatibility questions are asked
                 inside SpringBoard, which is also where the preference writes belong: the
                 process runs as mobile, and the pairing core refuses to write from anything
                 that is not. -->
            <string>com.apple.springboard</string>
        </array>
    </dict>

    <!-- Read by Albrhi Panel's SCIPanelScan, not by MobileSubstrate. One row named for the
         tweak rather than a row reading "SpringBoard", pushing to a real page: a master
         switch, what it answers, the diagnostics and a respring button do not fit in one
         switch cell. The same collapse Albrhi NextUp uses. -->
    <key>SCIPanelGroupIdentifier</key>
    <string>com.albrhi.watch</string>
    <key>SCIPanelGroupName</key>
    <string>Albrhi Watch</string>
    <key>SCIPanelDetailController</key>
    <string>SCIWatchSettingsController</string>
</dict>
</plist>
