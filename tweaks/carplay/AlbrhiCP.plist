<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
    <!-- Nothing pinned here: SpringBoard and Camera are system apps whose CFBundleVersion
         does not track an App Store release the way Instagram's or X's does, so there is
         no single number to compare a device against. -->

    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <!-- Where the CarPlay screen connects, and the only process with the live
                 scene-hosting machinery any future dashboard needs. -->
            <string>com.apple.springboard</string>

            <!-- The recording-quality fix. Named narrowly on purpose: this is the one
                 app the project's own test case names, and the filter is a one-line
                 change to widen once the mechanism is confirmed on a real device rather
                 than guessed at for every recording app at once. -->
            <string>com.apple.camera</string>

            <!-- Apple's own hidden system app that renders the CarPlay dashboard
                 background, found by reading its own compiled binary, not guessed at.
                 See CLAUDE.md's CarPlay section for how, and SCICPWallpaperHooks.h for
                 what runs here. -->
            <string>com.apple.CarPlayWallpaper</string>
        </array>
    </dict>

    <!-- Read by Albrhi Panel's SCIPanelScan, not by MobileSubstrate: one filter, two
         Bundles targets, would otherwise become two rows in Settings > Albrhi: "Camera"
         and "SpringBoard", as if they were two apps this project patches rather than
         two processes one feature happens to need. These three keys tell the scan to
         collapse both targets into a single row under this identity and name, and to
         push to a real settings page instead of offering a plain switch: the master
         on/off lives inside that page now, alongside the audio-fix and microphone
         choices, because a single row cannot carry three separate answers. -->
    <key>SCIPanelGroupIdentifier</key>
    <string>com.albrhi.carplay</string>
    <key>SCIPanelGroupName</key>
    <string>Albrhi CarPlay</string>
    <key>SCIPanelDetailController</key>
    <string>SCICPSettingsController</string>
</dict>
</plist>
