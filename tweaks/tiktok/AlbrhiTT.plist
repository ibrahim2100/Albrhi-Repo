<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">

<plist version="1.0">
<dict>
    <!-- The app version this tweak was last verified against. Read by Albrhi Panel
         and shown beside the installed version, so a mismatch is visible before it
         becomes a bug report. Substrate ignores keys it does not know. -->
    <key>SCITestedVersion</key>
    <string>46.4.0</string>

    <key>Filter</key>
    <dict>
        <key>Bundles</key>
        <array>
            <!-- TikTok's bundle id kept its own product name, Musically, from before the
                 rename, read from BHTikTok's own filter plist rather than guessed. -->
            <string>com.zhiliaoapp.musically</string>
        </array>
    </dict>
</dict>
</plist>
